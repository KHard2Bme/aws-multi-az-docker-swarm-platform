version: "3.8"

services:

  apache-a:
    image: kevd637/apache-website:v1

    ports:
      - "80:80"

    deploy:
      replicas: 1

      placement:
        constraints:
          - node.labels.workload == application
          - node.labels.az == us-east-1a

      restart_policy:
        condition: on-failure


  apache-b:
    image: kevd637/apache-website:v1

    deploy:
      replicas: 1

      placement:
        constraints:
          - node.labels.workload == application
          - node.labels.az == us-east-1b

      restart_policy:
        condition: on-failure


  apache-c:
    image: kevd637/apache-website:v1

    deploy:
      replicas: 1

      placement:
        constraints:
          - node.labels.workload == application
          - node.labels.az == us-east-1c

      restart_policy:
        condition: on-failure